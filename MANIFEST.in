include LICENSE README.md CHANGELOG.md pyproject.toml setup.cfg uv.lock alembic.ini compose.yaml .env.example
recursive-include agent *.py
recursive-include server *.py
recursive-include migrations *.py *.mako
recursive-include tests *.py *.mjs
