# Author: Fubuki. Replace checkout paths before installing with systemctl --user.
[Unit]
Description=Personal Compute Cloud Agent
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/PersonalComputeCloud
ExecStart=%h/PersonalComputeCloud/tmp/agent-venv/bin/pcc-agent run --config %h/PersonalComputeCloud/agent.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=default.target
