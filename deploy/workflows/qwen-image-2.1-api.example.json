{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "text": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae", 0],
      "prompt": "",
      "negative_prompt": "",
      "resolution": 1024,
      "images.image_1": ["ref1", 0],
      "images.image_2": ["ref2", 0],
      "images.image_3": ["ref3", 0],
      "images.image_4": ["ref4", 0]
    }
  },
  "cache": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": ["unet", 0],
      "device": "auto",
      "dtype": "default"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["cache", 0],
      "positive": ["text", 0],
      "negative": ["text", 1],
      "latent_image": ["latent", 0],
      "seed": 0,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sampler", 0],
      "vae": ["vae", 0]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["decode", 0],
      "filename_prefix": "pcc-qwen"
    }
  },
  "ref1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference-0.png"
    }
  },
  "ref2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference-1.png"
    }
  },
  "ref3": {
